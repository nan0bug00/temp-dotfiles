{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/julian/.config/fastfetch/logos/Iapetus_art.png",
    "type": "kitty",
    "padding": {
      "left" : 2,
      "top": 1
    },
    "height": 22,
    "width" : 45
  },
  /* "display": { */
  /*  "separator": " | " */
  /* }, */

    "display": {
        "separator": " -> "
    },
  "modules": [

    "break",
    {
        "type": "custom",
        "format": "\u001b[90m┌────────────────────────── iapetus ──────────────────────────┐"
    },
    {
        "type": "os",
        "key": " OS",
        "keyColor": "yellow"
    },
    {
        "type": "kernel",
        "key": "│ ├",
        "keyColor": "yellow"
    },
    {
        "type": "shell",
        "key": "│ └",
        "keyColor": "yellow"
    },
    {
        "type": "de",
        "key": " DE",
        "keyColor": "blue"
    },
    {
        "type": "wm",
        "key": "│ ├",
        "keyColor": "blue"
    },
    {
        "type": "wmtheme",
        "key": "│ ├󰉼",
        "keyColor": "blue"
    },
    {
        "type": "icons",
        "key": "│ ├󰀻",
        "keyColor": "blue"
    },
    {
        "type": "terminal",
        "key": "│ ├",
        "keyColor": "blue"
    },
    {
        "type": "host",
        "key": " PC",
        "format": "iapetus",
        "keyColor": "green"
    },
    {
        "type": "cpu",
        "key": "│ ├",
        "keyColor": "green"
    },
    {
        "type": "gpu",
        "key": "│ ├󰍛",
        "keyColor": "green"
    },
    {
        "type": "disk",
        "key": "│ ├",
        "keyColor": "green"
    },
    {
        "type": "memory",
        "key": "│ ├󰑭",
        "keyColor": "green"
    },
    {
        "type": "swap",
        "key": "│ ├󰓡",
        "keyColor": "green"
    },
    {
        "type": "uptime",
        "key": "│ ├󰅐",
        "keyColor": "green"
    },
    {
        "type": "display",
        "key": "│ └󰍹",
        "keyColor": "green"
    },
    {
        "type": "sound",
        "key": " SND",
        "keyColor": "cyan"
    },
    {
        "type": "player",
        "key": "│ ├󰥠",
        "keyColor": "cyan"
    },
    {
        "type": "media",
        "key": "│ └󰝚",
        "keyColor": "cyan"
    },
    {
        "type": "custom",
        "format": "\u001b[90m└───────────────────────────── 🔘 ─────────────────────────────┘"
    }
  ]
}
